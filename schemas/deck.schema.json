{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shotatykr/thinkmove-gpt-image2-slide-system/schemas/deck.schema.json",
  "title": "ThinkMove GPT-image2 deck manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "title", "mode", "brief", "sources", "versions", "generation", "slides", "release"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "deck_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "mode": {"const": "image-native"},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "job", "decision", "takeaway", "format"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "job": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "takeaway": {"type": "string", "minLength": 1},
        "format": {"enum": ["spoken", "standalone", "hybrid"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "location", "verified"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "verified": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "prompt", "reference_id", "system_commit", "design_commit"],
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "reference_id": {"type": "string", "minLength": 1},
        "system_commit": {"type": "string", "minLength": 7},
        "design_commit": {"type": "string", "minLength": 7}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "model", "quality", "width", "height", "max_attempts"],
      "properties": {
        "route": {"const": "built-in-imagegen"},
        "model": {"const": "gpt-image-2"},
        "quality": {"enum": ["medium", "high"]},
        "width": {"type": "integer", "minimum": 1280},
        "height": {"type": "integer", "minimum": 720},
        "max_attempts": {"const": 3}
      }
    },
    "slides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slide"}},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": {"enum": ["draft", "blocked", "approved"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "prompt_file", "references", "output_file", "result", "rejection_reasons", "copy_change"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 3},
        "prompt_file": {"type": "string", "minLength": 1},
        "references": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1}},
        "output_file": {"type": "string", "pattern": "\\.(png|jpg|jpeg)$"},
        "result": {"enum": ["accepted", "rejected"]},
        "rejection_reasons": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "copy_change": {"type": ["string", "null"]}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_failures", "scores", "human_approved", "approved_by"],
      "properties": {
        "hard_failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_fidelity", "readability", "visual_family", "layout_spacing", "narrative_role", "brand_handling"],
          "properties": {
            "source_fidelity": {"type": "integer", "minimum": 0, "maximum": 30},
            "readability": {"type": "integer", "minimum": 0, "maximum": 20},
            "visual_family": {"type": "integer", "minimum": 0, "maximum": 20},
            "layout_spacing": {"type": "integer", "minimum": 0, "maximum": 15},
            "narrative_role": {"type": "integer", "minimum": 0, "maximum": 10},
            "brand_handling": {"type": "integer", "minimum": 0, "maximum": 5}
          }
        },
        "human_approved": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role", "title", "claim", "visible_japanese", "copy_locked", "evidence", "visual_job", "anchor", "avoid", "status", "selected_attempt", "attempts", "qa"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "role": {"enum": ["cover", "greeting", "question", "evidence", "comparison", "concept", "process", "case", "section", "decision", "closing"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 45},
        "claim": {"type": "string", "minLength": 1, "maxLength": 120},
        "visible_japanese": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 45}},
        "copy_locked": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "visual_job": {"type": "string", "minLength": 1, "maxLength": 160},
        "anchor": {"type": "string", "minLength": 1},
        "avoid": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["planned", "generated", "blocked", "approved"]},
        "selected_attempt": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
        "attempts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
        "qa": {"$ref": "#/$defs/qa"}
      }
    }
  }
}
